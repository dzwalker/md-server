# md-server 配置样例（复制为 .env 后改值；.env 权限 600，已在 .gitignore 里）
#
# 两条链路：
#   1) 运行时密钥（R2_* / EMBED_*）——容器通过 compose 的 env_file 读取
#   2) 空间 set 布局（SET_*）——由 `node deploy/render-config.mjs` 渲染成 sets.json
#
# ⚠ 改了 .env 必须重建容器（compose up -d --force-recreate / --build）；
#   只 `docker compose restart` 不会重读 env_file。

# ── 编辑态图片（Cloudflare R2，可选；不配则图片回落文档目录 assets/） ──────────
R2_ENDPOINT=
R2_BUCKET=
R2_PREFIX=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=

# ── 语义索引（可选；默认 local 进程内模型，配了 openai 就走远端网关） ──────────
# 远端值示例：任意 OpenAI 兼容 /embeddings 端点
EMBED_PROVIDER=local
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
# 期望维度，仅作校验（不要作为 dimensions 参数下发，多数网关会对 text-embedding 系列 400）
EMBED_DIM=
# 单批条数；远端网关常见上限 10，超了报 batch size is invalid
EMBED_BATCH=

# ── 空间 set 布局（deploy/sets.json.tpl 的占位符值） ────────────────────────
# 每个 set 五个变量：ID / NAME / DIRS / EMBED / EXCLUDE
# DIRS 与 EXCLUDE 必须是合法 JSON 数组；EXCLUDE 只对 embed=true 的 set 生效。
# 目录名相对于 MD_BASE_DIR（默认 /data/workspace），可以是多层子路径。

SET_A_ID=l
SET_A_NAME=learning
SET_A_DIRS=["work-b","work-a"]
SET_A_EMBED=true
SET_A_EXCLUDE=["work-a/reorg-archived","work-a/recruitment"]

SET_B_ID=p
SET_B_NAME=personal
SET_B_DIRS=["investment","personal"]
SET_B_EMBED=false
SET_B_EXCLUDE=[]

SET_C_ID=work
SET_C_NAME=work
SET_C_DIRS=["work-a"]
SET_C_EMBED=false
SET_C_EXCLUDE=[]

SET_D_ID=archive
SET_D_NAME=archive
SET_D_DIRS=["archive"]
SET_D_EMBED=false
SET_D_EXCLUDE=[]

SET_E_ID=notes
SET_E_NAME=notes
SET_E_DIRS=["notes/个人","notes/学习"]
SET_E_EMBED=false
SET_E_EXCLUDE=[]
